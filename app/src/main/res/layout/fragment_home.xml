<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">



        <!-- 第一个卡片：Offline account配置 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 卡片标题 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Offline account configuration"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="16dp" />

                <!-- Username输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.QcofA.TextInputLayout"
                    app:boxBackgroundColor="@color/surface_container_low">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Username"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 可折叠区域标题 -->
                <LinearLayout
                    android:id="@+id/expandableSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:layout_marginBottom="8dp">

                    <!-- 三角符号指示器 -->
                    <TextView
                        android:id="@+id/expandIndicator"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="▶"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:gravity="center"
                        android:layout_marginEnd="8dp" />

                    <!-- Other options文本 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Other options"
                        android:textSize="16sp"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 可折叠区域 -->
                <LinearLayout
                    android:id="@+id/expandableSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 自定义UUID输入 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        style="@style/Widget.QcofA.TextInputLayout"
                        app:boxBackgroundColor="@color/surface_container_low">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/customUuidInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Custom UUID (leave blank to generate)"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Account type选择 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account type"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/userTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />

                    <!-- UUID显示 -->
                    <TextView
                        android:id="@+id/uuidDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="UUID: "
                        android:textSize="14sp"
                        android:textColor="@color/on_surface"
                        android:textIsSelectable="true"
                        android:background="@color/surface_container"
                        android:padding="12dp"
                        android:typeface="monospace" />

                    <!-- UI style选择（移入折叠区域，减少主界面占用） -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="UI style"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/themeStyleSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp" />
                </LinearLayout>

                <!-- 操作按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createAccountBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="Create account file"
                    style="@style/Widget.QcofA.Button"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/requestRootBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="Request root access"
                    style="@style/Widget.QcofA.Button"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/installQuestCraftBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="Install to QuestCraft"
                    style="@style/Widget.QcofA.Button"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/diagnoseQuestCraftBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="QuestCraft diagnostics"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/viewAccountsBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="View created accounts"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="4dp" />

                </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 第三个卡片：Version management（新功能集中放置） -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 卡片标题 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Version management"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skinChangeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Change skin"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveVersionListBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Save version list"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use this if the version list cannot be downloaded normally"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 第二个卡片：Basic configuration -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 卡片标题 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Basic configuration"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="16dp" />

                <!-- 配置选项 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/legalCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accepted legal terms (acceptedLegal)"
                    android:checked="true"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/devModsCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable developer mods (setDevMods)"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/customRamCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Custom RAM (setCustomRAM)"
                    android:layout_marginBottom="8dp" />

                <!-- 内存值输入 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.QcofA.TextInputLayout"
                    app:boxBackgroundColor="@color/surface_container_low">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ramValueInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Custom RAM值 (如: 2048)"
                        android:inputType="number"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/demoModeCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Demo mode (isDemoMode)"
                    android:layout_marginBottom="12dp" />

                <!-- 操作按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveConfigBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="Save configuration"
                    style="@style/Widget.QcofA.Button"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manualInstallJreBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="Manually install JRE Runtime"
                    style="@style/Widget.QcofA.Button"
                    app:backgroundTint="@color/surface_container_high"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="4dp" />

                </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>